        "label": "Conversão"
      },
      {
        "type": "kpi-simple",
        "source": "churn",
        "label": "Churn rate"
      }
    ],
    "right": [
      {
        "type": "kpi-metric",
        "source": "ticket",
        "label": "Ticket médio"
      },
      {
        "type": "kpi-simple",
        "source": "pipeline",
        "label": "Pipeline"
      },
      {
        "type": "kpi-ring",
        "source": "meta",
        "label": "Meta mensal"
      }
    ]
  },
  "bottom": {
    "type": "data-table",
    "source": "contracts",
    "columns": [
      "empresa",
      "contrato",
      "mrr",
      "status",
      "revisao"
