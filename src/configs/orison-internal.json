{
  "title": "Command Center",
  "hero": "globe",
  "theme": {
    "accent": "#8B1A1A",
    "accentHover": "#A52020",
    "accentText": "#F06070",
    "dataPrimary": "#d34e45",
    "surfaceDeep": "#0a0a0a",
    "surface": "#0d0d0f",
    "surfaceRaised": "#111113",
    "positive": "#3AAA62",
    "alert": "#E07840",
    "negative": "#F06070"
  },
  "panels": {
